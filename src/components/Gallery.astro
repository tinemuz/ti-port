---
import "@fancyapps/ui/dist/fancybox/fancybox.css";

interface Props {
  label?: string;
}

const { label = "Image gallery" } = Astro.props;
---

<section class="post-gallery not-prose" aria-label={label}>
  <slot />
</section>

<script>
  import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

  function bindGalleries() {
    Fancybox.unbind("[data-fancybox]");
    Fancybox.bind("[data-fancybox]", {
      theme: "auto",
      zoomEffect: false,
      showClass: "f-fadeIn",
      hideClass: "f-fadeOut",
      mainStyle: {
        "--f-button-width": "44px",
        "--f-button-height": "44px",
        "--f-button-border-radius": "50%",
        "--f-toolbar-padding": "16px",
      },
      Carousel: {
        Arrows: false,
        transition: "slide",
        Toolbar: {
          display: {
            left: [],
            middle: [],
            right: ["close"],
          },
        },
      },
    });
  }

  bindGalleries();
  document.addEventListener("astro:page-load", bindGalleries);
  document.addEventListener("astro:before-preparation", () => Fancybox.close());
</script>

<style>
  .post-gallery {
    width: 75vw;
    margin-left: calc((100% - 75vw) / 2);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-gallery :global(.gallery-image) {
    flex-grow: calc(var(--width) * (100000 / var(--height)));
    flex-basis: calc(
      clamp(200px, 20vw, 400px) * (var(--width) / var(--height))
    );
    aspect-ratio: var(--width) / var(--height);
    display: block;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid var(--color-skin-border);
  }

  .post-gallery :global(.gallery-image:focus-visible) {
    outline: 3px solid var(--color-skin-text);
    outline-offset: 2px;
    z-index: 1;
  }

  .post-gallery :global(.gallery-image img) {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0.375rem;
    object-fit: cover;
  }

  .post-gallery::after {
    content: "";
    flex-grow: 1000000000;
  }

  @media (max-width: 640px) {
    .post-gallery {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (min-width: 641px) {
    .post-gallery {
      gap: 0.75rem;
    }
  }
</style>
