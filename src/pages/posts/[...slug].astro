---
import MainLayout from "../../layouts/main-layout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatDateMonthYear } from "../../util/utils";

const { slug } = Astro.params;

if (slug === undefined) {
  throw new Error("Slug is required");
}

export async function getStaticPaths() {
  const allposts: CollectionEntry<"posts">[] = await getCollection("posts");

  return allposts.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: { entry },
  }));
}

const { entry } = Astro.props;

if (entry === undefined) {
  return Astro.redirect("/404");
}

const { Content } = await render(entry);
---

<MainLayout title={entry.data.title}>
  <div class="text-skin-text flex grow flex-col items-center">
    <div class="w-full pt-6 pb-16 sm:max-w-portfolio">
      <h1 class="pb-4">{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <p class="text-skin-text/50">
        {formatDateMonthYear(entry.data.pubDate)}
      </p>
    </div>
    <div
      class="prose prose-sm sm:prose-base w-full max-w-none sm:max-w-portfolio"
    >
      <Content />
    </div>
  </div>
</MainLayout>
